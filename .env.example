# === Database (Supabase Postgres) ===
# Supabase dashboard > Project Settings > Database > Connection string.
# DATABASE_URL: pooled connection (Transaction pooler, port 6543) — used by
# the running app. DIRECT_URL: direct connection (port 5432) — used by
# `prisma db push` / migrations.
DATABASE_URL="postgresql://postgres.sbxkpkqvuwntgissyuvy:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.sbxkpkqvuwntgissyuvy:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# === File uploads (Supabase Storage) ===
# Create a PUBLIC bucket (default name: uploads) in Supabase > Storage.
# The service role key is server-only — never expose it to the browser.
SUPABASE_URL="https://sbxkpkqvuwntgissyuvy.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="uploads"

# === Admin auth ===
# Random long string used to sign admin session cookies (openssl rand -hex 32)
ADMIN_SESSION_SECRET="change-this-to-a-long-random-string"

# Optional: choose the first admin account's credentials yourself. Leave
# unset and `npm run db:seed` will generate a strong random password and
# print it once to the terminal — either way, change it from /admin after
# your first login.
# DEFAULT_ADMIN_USERNAME="admin"
# DEFAULT_ADMIN_PASSWORD=""

# === Outgoing order emails ===
# SMTP credentials used to auto-send new orders to the store's inbox.
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="orders@example.com"
SMTP_PASS="your-smtp-password"

# Where every new order/inquiry is auto-forwarded to
ORDER_NOTIFY_EMAIL="info@example.com"
ORDER_FROM_EMAIL="orders@example.com"

# === WhatsApp click-to-chat ===
# International format, digits only, no "+" or spaces
NEXT_PUBLIC_WHATSAPP_NUMBER="000000000000"

# === AI assistant (storefront chat widget) ===
# Leave AI_PROVIDER="none" to keep the chat widget hidden/disabled until
# you're ready. Set to "anthropic" or "openai" and fill in the matching key
# to switch it on — the assistant only answers from the Knowledge Base you
# manage in /admin/ai plus the live product catalog.
AI_PROVIDER="none"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL="claude-3-5-haiku-20241022"
NEXT_PUBLIC_AI_CHAT_ENABLED="false"

# === Site ===
NEXT_PUBLIC_SITE_NAME="Syroleb"
# Optional on Vercel (falls back to the project's production domain); set it
# once you attach a custom domain.
NEXT_PUBLIC_SITE_URL=""

# === Internal system (/system) and accounting (/accounting) ===
# Long random string signing the /system + /accounting session cookies
SYSTEM_SESSION_SECRET="change-this-to-another-long-random-string"
# First owner account for /system, created by the bootstrap endpoint
SYSTEM_OWNER_EMAIL="owner@example.com"
SYSTEM_OWNER_PASSWORD="change-me"
# Protects the scheduled jobs (/api/system/cron/*) — see .github/workflows/cron.yml
CRON_SECRET="change-this-too"
